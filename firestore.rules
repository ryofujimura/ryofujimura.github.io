rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection - username-based documents
    // Document ID = username for easy lookup
    match /users/{username} {
      // Allow anyone to read (needed to check if user exists)
      // Only exposes: username, messageCount, timestamps (no sensitive data)
      allow read: if true;
      
      // Allow anyone to create or update (for message count increment)
      allow create, update: if request.resource.data.keys().hasAll(['username', 'messageCount', 'firstMessageAt', 'lastMessageAt'])
                            && request.resource.data.username is string
                            && request.resource.data.username.size() > 0
                            && request.resource.data.username.size() <= 50
                            && request.resource.data.messageCount is int;
      
      // Only authenticated users can delete
      allow delete: if request.auth != null;
    }
    
    // Messages collection - stores contact form messages
    match /messages/{messageId} {
      // Allow anyone to create a new message
      allow create: if request.resource.data.keys().hasAll(['username', 'message', 'sentAt', 'status'])
                    && request.resource.data.username is string
                    && request.resource.data.username.size() > 0
                    && request.resource.data.username.size() <= 50
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 5000
                    && request.resource.data.status == 'new';
      
      // Only allow reading by authenticated users (for admin dashboard)
      allow read: if request.auth != null;
      
      // Allow authenticated users to update status (mark as read/replied)
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                    && request.resource.data.status in ['new', 'read', 'replied'];
      
      // Only authenticated users can delete
      allow delete: if request.auth != null;
    }
    
    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
