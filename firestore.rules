rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Visitors collection - stores device/browser fingerprinting data
    // Write: Anyone can create (when submitting contact form)
    // Read: Only authenticated admins (you)
    match /visitors/{visitorId} {
      // Allow anyone to create a new visitor document
      allow create: if true;
      
      // Only allow reading by authenticated users (for admin dashboard)
      allow read: if request.auth != null;
      
      // No updates or deletes from client
      allow update, delete: if false;
    }
    
    // Messages collection - stores contact form messages
    // Write: Anyone can create (when submitting contact form)
    // Read: Only authenticated admins (you)
    match /messages/{messageId} {
      // Allow anyone to create a new message
      // Validate that required fields exist
      allow create: if request.resource.data.keys().hasAll(['message', 'visitorId', 'sentAt', 'status'])
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 5000
                    && request.resource.data.visitorId is string
                    && request.resource.data.status == 'new';
      
      // Only allow reading by authenticated users (for admin dashboard)
      allow read: if request.auth != null;
      
      // Allow authenticated users to update status (mark as read/replied)
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                    && request.resource.data.status in ['new', 'read', 'replied'];
      
      // Only authenticated users can delete
      allow delete: if request.auth != null;
    }
    
    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
